<% layout("/layouts/boilerplate.ejs") %>

<div style="padding: 20px;">
  <h1>Admin Dashboard</h1>

  <section style="margin-bottom: 30px;">
    <h2>Overview Analytics</h2>
    <p><strong>Total Listings:</strong> <%= totalListings %></p>
    <p><strong>Total Users:</strong> <%= totalUsers %></p>
  </section>

  <section style="margin-bottom: 30px;">
    <h2>Per-User Breakdown</h2>
    <table border="1" cellpadding="8" cellspacing="0">
      <thead>
        <tr>
          <th>User ID</th>
          <th>Username</th>
          <th>Listings Owned</th>
        </tr>
      </thead>
      <tbody>
        <% if (userBreakdown && userBreakdown.length > 0) { %>
          <% for (let item of userBreakdown) { %>
            <tr>
              <td><%= item._id %></td>
              <td><%= item.username %></td>
              <td><%= item.listingCount %></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr>
            <td colspan="3">No user listings found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <section style="margin-bottom: 30px;">
    <h2>All Listings (Admin Management)</h2>
    <table border="1" cellpadding="8" cellspacing="0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Owner</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (allListings && allListings.length > 0) { %>
          <% for (let listing of allListings) { %>
            <tr>
              <td><a href="/listings/<%= listing._id %>"><%= listing.title %></a></td>
              <td><%= listing.owner ? listing.owner.username : "Unknown" %></td>
              <td>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></td>
              <td>
                <a href="/listings/<%= listing._id %>/edit">Edit</a>
                &nbsp;|&nbsp;
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                  <button type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% } %>
        <% } else { %>
          <tr>
            <td colspan="4">No listings available.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>
</div>
